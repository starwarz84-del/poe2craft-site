// Cloudflare Workers deploy: serves the web/ folder as a static site (built by scripts/build_web.py)
// and the request API under /api/ (worker/index.js, KV binding REQ — created automatically on first deploy).
{
  "name": "poe2craft",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    // 확장자 없는 주소(/recipes 등)는 Worker가 껍데기로 받음 → .html 자동 이동을 끔. www 301 이동도 Worker가 처리(페이지·robots·sitemap 요청)
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/", "/recipes", "/recipes/", "/discover", "/discover/", "/emulator", "/emulator/", "/builder", "/builder/", "/bases", "/bases/", "/*.html", "/robots.txt", "/sitemap.xml"]
  },
  "kv_namespaces": [
    { "binding": "REQ" }
  ]
}
